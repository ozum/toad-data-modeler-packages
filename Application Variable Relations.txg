	<Scripts>
		<Script ObjectType="105" CSAOName="Script" CSAOCaption="TScriptFactory">
			<Id>{300B1CDE-927A-4827-841E-1D04F0B378CB}</Id>
			<Name>PERRelation_Variable</Name>
			<Ordinal>0</Ordinal>
			<GlobalOrder>0</GlobalOrder>
			<ScriptTypeId>0</ScriptTypeId>
			<Description/>
			<History/>
			<Source>
<![CDATA[function SingularizeName(name)
{
  if (name == null) return "";

  var s = "" + name;
  var lower = s.toLowerCase();

  if (lower == "people") return "person";
  if (lower == "children") return "child";
  if (lower == "statuses") return s.substr(0, s.length - 2);

  // companies -> company
  if (s.length > 3 && lower.substr(lower.length - 3) == "ies") {
    return s.substr(0, s.length - 3) + "y";
  }

  // classes -> class, boxes -> box
  if (
    s.length > 2 &&
    (
      lower.substr(lower.length - 3) == "ses" ||
      lower.substr(lower.length - 3) == "xes" ||
      lower.substr(lower.length - 4) == "shes" ||
      lower.substr(lower.length - 4) == "ches"
    )
  ) {
    return s.replace(/es$/i, "");
  }

  // customers -> customer
  if (s.length > 1 && lower.substr(lower.length - 1) == "s") {
    return s.substr(0, s.length - 1);
  }

  return s;
}

function GetSingularParentTableName()
{
  if (Instance == null || Instance.ParentEntity == null) return "";
  return SingularizeName(Instance.ParentEntity.Name);
}

function GetSingularChildTableName()
{
  if (Instance == null || Instance.ChildEntity == null) return "";
  return SingularizeName(Instance.ChildEntity.Name);
}

function GetSingularParentTableCaption()
{
  if (Instance == null || Instance.ParentEntity == null) return "";
  return SingularizeName(Instance.ParentEntity.Caption);
}

function GetSingularChildTableCaption()
{
  if (Instance == null || Instance.ChildEntity == null) return "";
  return SingularizeName(Instance.ChildEntity.Caption);
}]]>

		<Script ObjectType="105" CSAOName="Script" CSAOCaption="TScriptFactory">
			<Id>{C015577D-6289-4206-B1DC-F459D7F7EF09}</Id>
			<Name>PEREntity_Variable</Name>
			<Ordinal>0</Ordinal>
			<GlobalOrder>0</GlobalOrder>
			<ScriptTypeId>0</ScriptTypeId>
			<Description/>
			<History/>
			<Source>
<![CDATA[function GetFullNameQuoted() {
  var ownerName = Instance.schema ? '"' + Instance.schema.name + '".' : '';
  var name = '"' + Instance.name + '"';
  return ownerName + name;
};

function GetSchemaNameQuoted() {
  return Instance.schema ? '"' + Instance.schema.name + '"' : '';
}

function GetSchemaName() {
  return Instance.schema ? Instance.schema.name : '';
}

function GetSchemaNameQuotedDot() {
  return Instance.schema ? '"' + Instance.schema.name + '".' : '';
}]]>
			</Source>

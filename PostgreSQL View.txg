	<Scripts>
		<Script ObjectType="105" CSAOName="Script" CSAOCaption="TScriptFactory">
			<Id>{821433DE-DEF4-4707-B675-755D9FCB7293}</Id>
			<Name>PERCodeGeneratorPG12_View</Name>
			<Ordinal>0</Ordinal>
			<GlobalOrder>0</GlobalOrder>
			<ScriptTypeId>0</ScriptTypeId>
			<Description/>
			<History/>
			<Source>
<![CDATA[function CreateView(view, flag) {
  var sql = addOptions(view, flag);
  return sql; 
}


// This function removes add "security_barrier" and "security_invoker"
// options to views.
function addOptions(view, flag) {
  var sql = Instance.CreateView(view, flag);
  var options = [];
  
  if (view.securityBarrier) options.push("security_barrier = on");
  if (view.securityInvoker) options.push("security_invoker = on");

  var optionsSQL = options.length > 0 ? " WITH (" + options.join(", ") + ") AS" : " AS"; 

  sql = sql.replace(/ AS/i, optionsSQL);
  return sql;
}; ]]>
			</Source>

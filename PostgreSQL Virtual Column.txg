	<Scripts>
		<Script ObjectType="105" CSAOName="Script" CSAOCaption="TScriptFactory">
			<Id>{72DB6618-F4CF-40E8-98B5-CA44607BAB2D}</Id>
			<Name>PERCodeGeneratorPG12_stored_generated</Name>
			<Ordinal>0</Ordinal>
			<GlobalOrder>0</GlobalOrder>
			<ScriptTypeId>0</ScriptTypeId>
			<Description/>
			<History/>
			<Source>
<![CDATA[function CreateTable(table, otherName, arrAttrChangedUDTName) {
  var sql = removeGeneratedStored(table, otherName, arrAttrChangedUDTName);
  return sql; 
}


// This function removes STORED keyword from non-stored generated attributes.
// Toad Data Modeler does not have "Stored" option out of the box.
// We added a custom attribute "storedVirtual" using meta model
// and customized attribute for as necessary to this function work.
function removeGeneratedStored(table, otherName, arrAttrChangedUDTName) {
  var sql = Instance.CreateTable(table, otherName, arrAttrChangedUDTName);
  
  for (var i = 0; i < table.attributes.count; i++) {
    var attribute = table.attributes.getObject(i);
    if (attribute.useGenerated && attribute.storedVirtual)
      sql = sql.replace(new RegExp("(" + attribute.name + "(.|(\r\n))+?) STORED", "i"), "$1 VIRTUAL");   
  }
    
  return sql;
}; ]]>
			</Source>
